MADD_ENVIRONMENT=pilot
MADD_PILOT_HOST=diligence.example.com
MADD_TLS_EMAIL=security@example.com
MADD_IMAGE=madd-pilot
MADD_IMAGE_TAG=replace-with-release-sha
MADD_RELEASE_SHA=replace-with-release-sha
MADD_FORWARDED_ALLOW_IPS=*
MADD_PILOT_DATA_VOLUME=madd-pilot-pilot-data
MADD_PILOT_BACKUP_VOLUME=madd-pilot-pilot-backups
MADD_DATA_SUBDIRECTORY=current

# Generate three independent URL-safe base64-encoded 32-byte keys and store the real values only
# in the host secret store or a permission-restricted deployment environment file.
MADD_DOCUMENT_KEY=
MADD_CHECKPOINT_KEY=
MADD_BACKUP_KEY=

MADD_BOOTSTRAP_ADMIN_EMAIL=
MADD_BOOTSTRAP_ADMIN_PASSWORD=
MADD_BOOTSTRAP_ADMIN_NAME=Pilot Administrator
MADD_MAX_UPLOAD_BYTES=52428800
MADD_LOGIN_ATTEMPT_LIMIT=5
MADD_LOGIN_WINDOW_SECONDS=300
MADD_LOGIN_BLOCK_SECONDS=900
MADD_BACKUP_RETAIN_COUNT=14
MADD_AI_MODE=local_demo
