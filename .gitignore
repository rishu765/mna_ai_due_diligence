# Python caches and environments across projects
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/.tox/
**/dist/
**/build/

# Secrets
**/.env
**/.env.*
!**/.env.example
!deploy/.env.pilot.example

# Local/generated project data
**/data/raw/*
**/data/processed/*
**/artifacts/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/artifacts/.gitkeep

# Coverage, editors, and operating systems
**/.coverage
**/htmlcov/
**/coverage.xml
**/*.log
work/
pilot-data/
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*.madd
.idea/
.vscode/
.DS_Store
Thumbs.db
