# Project 5 runs fully offline and requires no credentials.
# Add optional provider-specific variables only when implementing an approved live adapter.

# Pilot-only encrypted document storage. Generate a URL-safe 32-byte key outside Git and store it
# in the deployment secret manager. Never commit the actual value.
MADD_DOCUMENT_KEY=

# Use a separate key for encrypted LangGraph checkpoints.
MADD_CHECKPOINT_KEY=
